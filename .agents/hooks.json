{
  "auto-verify-reminder": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/auto-verify-reminder.cjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
